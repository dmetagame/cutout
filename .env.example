# Cutout Milestone 4 production-like configuration.
# Keep this file free of API keys and wallet secrets. Use a secret manager or
# an untracked environment file for any provider credential embedded in a URL.

NODE_ENV=production
CHAIN_ID=0x534e5f4d41494e
POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# The indexer selects one provider for each complete sync attempt.
CUTOUT_RPC_PRIMARY_URL=https://rpc.starknet.lava.build
CUTOUT_RPC_SECONDARY_URL=https://api.cartridge.gg/x/starknet/mainnet
CUTOUT_RPC_TIMEOUT_MS=12000
CUTOUT_RETRY_INITIAL_MS=1000
CUTOUT_RETRY_MAX_MS=30000
CUTOUT_RPC_RANGE_BLOCKS=200000
CUTOUT_INDEX_INTERVAL_SECONDS=15

# Both services use the same persistent volume. The API connection is read-only
# and query-only; the filesystem remains writable for SQLite WAL/SHM coordination.
CUTOUT_DB_PATH=/var/lib/cutout/cutout.sqlite

# This value is intentionally separate from server RPC configuration and is the
# only RPC URL made available to the browser bootstrap.
CUTOUT_BROWSER_RPC_URL=https://rpc.starknet.lava.build

PORT=3000
